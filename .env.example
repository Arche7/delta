# Пример переменных. На Railway их вписывают во вкладке Variables, сюда настоящие значения не пишем.

# Токен бота от @BotFather (выглядит как 123456789:AA...)
BOT_TOKEN=

# Публичный адрес сервиса на Railway, без «/» в конце
PUBLIC_URL=https://ваш-адрес.up.railway.app

# Где хранится база. На Railway подключите Volume с путём /data
DB_PATH=/data/delta.db

# Необязательно: бесплатный demo-ключ CoinGecko, если курсы USDT/BTC не грузятся
COINGECKO_KEY=
